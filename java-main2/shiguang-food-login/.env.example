# 复制为 .env 后按需修改
# 后端基础地址（接口会拼接为 ${VITE_API_BASE}/auth/register 等）
# 默认相对路径 /api，由 vite.config.js 的 proxy 转发到 http://192.168.68.31:8081；
# 也可写成绝对地址 http://192.168.68.31:8081/api 直接跨域访问后端
VITE_API_BASE=/api

# 是否启用本地模拟后端：true 走模拟（无需后端即可运行），false 走真实接口
# 走真实后端需已安装 axios（本项目已内置）。默认 false，登录/注册才会写入 MySQL
VITE_USE_MOCK=false

# 后台管理系统独立开关：与 VITE_USE_MOCK 分开，可单独让后台连真实接口
# （后台接口统一挂在 /api/admin 下，真实模式下需启动 springBootTest）
VITE_ADMIN_USE_MOCK=false
